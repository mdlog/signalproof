# SignalProof — environment template
#
# Copy to .env and fill in. .env is gitignored; never commit a private key.
#
# The app degrades honestly: with none of the chain variables set, the gateway still accepts and
# stores measurements as SUBMITTED, the proof worker does not start, and the UI reports the
# measurements as unverified. Nothing anywhere claims a proof exists when none was built.

# ----------------------------------------------------------------------------
# Core application
# ----------------------------------------------------------------------------

# MySQL connection string. Without it the app runs but persists nothing.
DATABASE_URL=mysql://user:password@localhost:3306/signalproof

# Secret for signing the session cookie (HS256). Any long random string.
JWT_SECRET=

# ----------------------------------------------------------------------------
# Manus platform (scaffold — only needed for OAuth login and object storage)
# ----------------------------------------------------------------------------

VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ----------------------------------------------------------------------------
# Source chain — Ethereum Sepolia (chain id 11155111)
# ----------------------------------------------------------------------------

# Keyless public endpoint. Alchemy/Infura also fine.
#
# Not PublicNode for the dashboard: on 2026-09-11 https://ethereum-sepolia-rpc.publicnode.com
# answered the same `eth_getLogs` with an empty array on 4 of 8 identical calls — no error, just
# nothing — which reads as "no measurements". The server re-asks empty answers and never lets a
# re-read shrink what it already showed, but a consistent endpoint is still the first line.
SEPOLIA_RPC_URL=https://sepolia.gateway.tenderly.co

# Relayer EOA that pays gas to record measurement commitments.
# Use a burner key funded only from a faucet. Never a wallet holding real value.
#   Faucets with no mainnet-balance gate:
#     https://faucet.quicknode.com/ethereum/sepolia   (12h cooldown, CAPTCHA, EOA only)
#     https://sepolia-faucet.pk910.de                 (proof-of-work, no prerequisites)
#   With >= 0.001 mainnet ETH: https://www.alchemy.com/faucets/ethereum-sepolia (0.1 ETH/24h)
SEPOLIA_RELAYER_PRIVATE_KEY=

# From `pnpm deploy:sepolia`. Pre-filled with the live hackathon deployment (a public value):
# leave it and the dashboard reads real settlements with no key and no deploy of your own.
# This registry recovers the contributor's signature on-chain before it records anything.
SOURCE_BATCH_REGISTRY_ADDRESS=0x32c0923cD58523864D2727FCaaB109783664c236

# Earlier registries whose history is still shown, as address:deployBlock pairs. The first gated
# registry (no on-chain signature check, relayer-gated only) holds seven settled measurements.
RETIRED_REGISTRIES=0x15F3d74846a40bD67f8ce345B73ae4c400f759Dc:11658403

# ----------------------------------------------------------------------------
# Destination chain — Creditcoin CC3 Testnet (chain id 102031)
# ----------------------------------------------------------------------------

# Do not confuse with Devnet (102032) or Mainnet (102030). The app refuses to start on either.
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Relayer EOA that submits proofs to the settlement contract.
# CTC has NO web faucet. The only official route is the Discord bot:
#   https://discord.gg/creditcoin -> #token-faucet -> /faucet address:<your EVM address>
# Verify the balance at https://creditcoin-testnet.blockscout.com/
# If the dispensed amount is too small to deploy, escalate in #buidl-ctc-qna
# (https://discord.gg/Gu43zTfmtc) or email team@creditcoin.org, mentioning the hackathon.
CREDITCOIN_RELAYER_PRIVATE_KEY=

# From `pnpm deploy:cc3`. Pre-filled with the live hackathon deployments, as above.
SETTLEMENT_CONTRACT_ADDRESS=0x8F14B2cC1b807203d332DE6E3DA6274176FDb584
# Second settlement route: many measurements, one continuity proof, one transaction.
BATCH_SETTLEMENT_ADDRESS=0x3B90e22f246bBa68f6de682b564c33b121D68C85

# ----------------------------------------------------------------------------
# Attestcoin Protocol
# ----------------------------------------------------------------------------

# Attestcoin chain key for Sepolia. Informational only: the app resolves this at startup from the
# ChainInfo precompile and warns if the two disagree. Hardcoding it is unsafe, because key 1 on
# CC3 Mainnet identifies a different chain entirely.
ATTESTCOIN_CHAIN_KEY=1

# Hosted proof builder for CC3 Testnet.
ATTESTCOIN_PROOF_SERVICE_URL=https://prover.cc3-testnet.creditcoin.network

# ----------------------------------------------------------------------------
# Deployment (read by the Foundry scripts, not by the server)
# ----------------------------------------------------------------------------

DEPLOYER_PRIVATE_KEY=

# Optional deploy-time overrides.
# SETTLEMENT_REWARD_WEI=1000000000000000        # 0.001 CTC per verified measurement
# SETTLEMENT_MAX_AGE_SECONDS=86400              # 24h freshness window
# FUND_AMOUNT_WEI=50000000000000000             # 0.05 CTC into the reward pool

# Block each contract was created in. Scanning from here instead of a fixed lookback keeps
# the dashboard's first paint fast and keeps full history as the chains grow. Written by the
# deploy scripts; pre-filled for the live deployments above.
SOURCE_BATCH_REGISTRY_DEPLOY_BLOCK=11681375
SETTLEMENT_DEPLOY_BLOCK=5448580
BATCH_SETTLEMENT_DEPLOY_BLOCK=5449853

# ----------------------------------------------------------------------------
# Demo modes
# ----------------------------------------------------------------------------

# full (default): the worker relays measurements to Sepolia AND settles them on Creditcoin.
# relay-only: the worker relays but never settles, so the only path to a reward is a contributor
# pressing "Settle from my wallet" — the demonstration that execute() is permissionless.
PROOF_WORKER_MODE=full

# ----------------------------------------------------------------------------
# Buyer access — metered API, paid into the reward pool
# ----------------------------------------------------------------------------
# A buyer sends BUYER_ACCESS_PRICE_CTC to SETTLEMENT_CONTRACT_ADDRESS (its receive() credits the
# reward pool contributors claim() from), signs the transaction hash with the paying wallet, and
# POST /v1/access/redeem returns a key valid for BUYER_ACCESS_DAYS. Keys are stateless HMACs over
# the payment, so nothing is stored and the same payment always yields the same key.
# With no BUYER_ACCESS_SECRET (and no JWT_SECRET to fall back on) the gate is OPEN: every /v1
# endpoint is free and the purchase card hides itself — a keyless clone keeps working.
BUYER_ACCESS_SECRET=
BUYER_ACCESS_PRICE_CTC=0.05
BUYER_ACCESS_DAYS=30
